# MIRAI OS 環境変数テンプレート
#
# このファイルは「どの変数が必要か」を示すテンプレートです。
# 実際の値はここには書かず、このファイルをコピーして
# 「.env.local」という名前で保存し、そちらに値を入力してください。
#
# .env.local はGitにコミットされません（.gitignoreで除外設定済み）。
# 値（特に SUPABASE_SERVICE_ROLE_KEY）は、チャットや
# Gitに一切含めないでください。

# --- Supabase接続情報（開発用プロジェクト） ---
# Supabaseダッシュボード「Project Settings」→「API」から取得します。

# プロジェクトURL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# anon / public キー（ブラウザ側で使用する、公開前提のキー）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role キー（サーバー側のみで使用する、非公開の強い権限を持つキー）
# 【重要】このキーは絶対に外部へ公開しない・チャットに貼らない・Gitへコミットしないこと
SUPABASE_SERVICE_ROLE_KEY=
